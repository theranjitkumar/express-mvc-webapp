<section style="margin: 30px 0;">
    <h2>Our {{title}}</h2>
    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;">

        {{#each services}}
        <div
            style="border: 1px solid #ddd; border-radius: 10px; padding: 15px; box-shadow: 0 4px 10px rgba(0,0,0,0.1); text-align: center;">

            <img src="{{this.thumbnail}}" alt="{{this.title}}"
                style="width: 100%; height: 180px; object-fit: cover; border-radius: 8px;">

            <h3 style="margin: 15px 0 10px; font-size: 20px;">
                {{this.title}}
            </h3>

            <p style="font-size: 14px; color: #555;">
                {{this.description}}
            </p>

            <a href="/services/{{this.slug}}"
                style="display: inline-block; margin-top: 10px; padding: 8px 15px; background-color: #007bff; color: #fff; text-decoration: none; border-radius: 5px;">
                Read More
            </a>

        </div>
        {{/each}}

    </div>
</section>